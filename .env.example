# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Didit — leave DIDIT_API_KEY empty to run in MOCK mode (simulated Didit screen, no API calls)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_BASE=https://verification.didit.me

# Public URL of this app, no trailing slash (used for the Didit callback)
APP_URL=http://localhost:3000

# Whole-app access code (default 412099 if empty)
APP_ACCESS_CODE=

# Admin console access code and cookie-signing secret
ADMIN_ACCESS_CODE=
SESSION_SECRET=
